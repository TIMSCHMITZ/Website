---
import MonoMarker from '../brand/MonoMarker.astro';
---

<section id="referenzen" class="section section--sand stimmen">
  <div class="container">
    <MonoMarker>06 · Stimmen</MonoMarker>
    <h2 class="stimmen__h2">
      Was Inhaber sagen, mit denen ich gearbeitet habe.
    </h2>

    <div class="stimmen__embed">
      <div
        class="famewall-embed"
        data-src="laminarsolutions"
        data-format="carousel"
        style="width:100%;"
      >
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  type="text/javascript"
  src="https://embed.famewall.io/newFrame.js"
  defer></script>

<style>
  .stimmen__h2 {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.0;
    margin: 24px 0 64px;
    max-width: 760px;
  }

  .stimmen__embed {
    width: 100%;
  }

  @media (max-width: 900px) {
    .stimmen__h2 {
      font-size: 28px;
      margin: 20px 0 40px;
    }
  }
</style>
