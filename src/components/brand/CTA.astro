---
interface Props {
  href?: string;
  variant?: 'dark' | 'light';
  rel?: string;
  target?: string;
}

const { href = '#kontakt', variant = 'dark', rel, target } = Astro.props;
---

<a class={`cta cta--${variant}`} href={href} rel={rel} target={target}>
  <span class="cta-label"><slot /></span>
  <span class="cta-dot" aria-hidden="true"></span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 24px;
    font-family: var(--font);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    border: 0;
    position: relative;
    overflow: hidden;
    transition: color 200ms ease;
  }

  /* Hover: Lehm zieht als Fläche von links auf (Experiment-Branch). */
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta:hover::after,
  .cta:focus-visible::after {
    transform: scaleX(1);
  }

  .cta--dark {
    background: var(--ink);
    color: var(--bg);
  }

  .cta--light {
    background: var(--bg);
    color: var(--ink);
  }

  .cta--light:hover,
  .cta--light:focus-visible {
    color: var(--bg);
  }

  .cta-label,
  .cta-dot {
    position: relative;
    z-index: 1;
  }

  .cta-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    display: inline-block;
    transition: background 200ms ease;
  }

  .cta--dark:hover .cta-dot,
  .cta--light:hover .cta-dot {
    background: var(--bg);
  }
</style>
