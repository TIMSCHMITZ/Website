---
interface Props {
  size?: number;
  variant?: 'dark' | 'light';
  class?: string;
}

// Knoten-Marke, Geometrie aus source/knoten.svg übernommen.
// viewBox 114.15 × 105.24 (nicht quadratisch) — Höhe folgt dem Seitenverhältnis.
const { size = 120, variant = 'dark', class: className } = Astro.props;
const bar = variant === 'light' ? '#f1ebde' : '#16223a';
const height = (size * 105.24) / 114.15;
---

<svg
  class={className}
  viewBox="0 0 114.15 105.24"
  width={size}
  height={height}
  aria-hidden="true"
  focusable="false"
>
  <g fill={bar}>
    <rect y="87.6" width="76.18" height="17.64" />
    <rect
      x="49.38"
      y="55.07"
      width="76.18"
      height="17.64"
      transform="translate(75.87 171.59) rotate(-120)"
    />
    <rect
      x="-3.48"
      y="28.58"
      width="76.18"
      height="17.64"
      transform="translate(84.3 26.12) rotate(120)"
    />
  </g>
  <circle cx="53.07" cy="65.94" r="10" fill="#b85a3f" />
</svg>
