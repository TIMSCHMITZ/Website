---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}

// Nav-Brand: volle Wortmarke (Knoten + Schriftzug) als ein Asset.
// variant 'dark'  = dunkle Marke für helle Flächen
// variant 'light' = helle Marke für dunkle Flächen
const { variant = 'light', class: className } = Astro.props;
const src = variant === 'light' ? '/logo-wordmark-light.svg' : '/logo-wordmark-dark.svg';
---

<img
  src={src}
  alt="Schmitz Systemarchitektur"
  width="210"
  height="50"
  class={['lockup', className].filter(Boolean).join(' ')}
  decoding="async"
  draggable="false"
/>

<style>
  .lockup {
    display: block;
    width: 210px;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 900px) {
    .lockup {
      width: 172px;
    }
  }

  @media (max-width: 380px) {
    .lockup {
      width: 144px;
    }
  }
</style>
