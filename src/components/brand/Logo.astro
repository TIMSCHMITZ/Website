---
interface Props {
  width?: number;
  variant?: 'dark' | 'light';
  class?: string;
}

// Volle Wortmarke (Knoten + Schriftzug) als ein Asset.
// variant 'dark'  = dunkle Marke (logo-wordmark-dark.svg) für helle Flächen
// variant 'light' = helle Marke (logo-wordmark-light.svg) für dunkle Flächen
const { width = 260, variant = 'light', class: className } = Astro.props;
const src = variant === 'light' ? '/logo-wordmark-light.svg' : '/logo-wordmark-dark.svg';
const height = Math.round((width * 179.29) / 759.61);
---

<img
  src={src}
  alt="Schmitz Systemarchitektur"
  width={width}
  height={height}
  style={`width:${width}px`}
  class={['logo', className].filter(Boolean).join(' ')}
  decoding="async"
  draggable="false"
/>

<style>
  .logo {
    display: block;
    max-width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
